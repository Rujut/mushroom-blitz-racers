{
  "name": "mushroom-blitz-racers",
  "main": "index",
  "version": "1.0.0",
  "scripts": {
    "start": "EXPO_OFFLINE=1 expo start --offline",
    "start:tunnel": "expo start --tunnel",
    "start:clear": "EXPO_OFFLINE=1 expo start -c --offline",
    "android": "EXPO_OFFLINE=1 expo start --android --offline",
    "ios": "EXPO_OFFLINE=1 expo start --ios --offline",
    "web": "EXPO_OFFLINE=1 expo start --web --offline",
    "postinstall": "setup-skia-web",
    "setup:skia-web": "setup-skia-web",
    "typecheck": "tsc --noEmit",
    "verify:bundle:android": "EXPO_OFFLINE=1 npx expo export --platform android --output-dir /tmp/mbr-android-export",
    "verify:bundle:web": "EXPO_OFFLINE=1 npx expo export --platform web --output-dir /tmp/mbr-web-export",
    "verify:part1": "npm run typecheck && npm run verify:bundle:android",
    "test:engine": "npx tsx src/game/core/GameEngine.test.ts",
    "verify:part2": "npm run typecheck && npm run test:engine && npm run verify:bundle:android"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/native": "^7.1.8",
    "@shopify/react-native-skia": "2.2.12",
    "canvaskit-wasm": "^0.40.0",
    "expo": "~54.0.33",
    "expo-apple-authentication": "~8.0.8",
    "expo-asset": "~12.0.13",
    "expo-av": "~16.0.8",
    "expo-constants": "~18.0.13",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.11",
    "expo-navigation-bar": "~5.0.10",
    "expo-router": "~6.0.23",
    "expo-screen-orientation": "~9.0.9",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.10",
    "firebase": "^12.13.0",
    "matter-js": "^0.20.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/matter-js": "^0.20.2",
    "@types/react": "~19.1.0",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
